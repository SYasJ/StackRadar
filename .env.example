# StackRadar environment variables: ALL OPTIONAL.
#
# StackRadar needs no configuration, API keys or secrets: `python3 stackradar.py` just works.
# These variables only change defaults. StackRadar reads them from your environment
# (it does not load this file itself), so export them in your shell or use a tool like direnv:
#     cp .env.example .env && set -a && . ./.env && set +a && python3 stackradar.py

# --- Updates -------------------------------------------------------------------------------
# GitHub "owner/repo" StackRadar checks for new releases (also editable in Settings).
# STACKRADAR_REPO=SYasJ/StackRadar

# --- Network Guard upstream proxy ------------------------------------------------------------
# If you already sit behind a corporate proxy, the Network Guard's local egress proxy chains to it.
# HTTPS_PROXY=http://proxy.example.com:8080
# HTTP_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,.internal.example.com

# --- Scanning hints --------------------------------------------------------------------------
# Used to find shell config and caches when they're not in the default places.
# SHELL=/bin/zsh
# ZSH=~/.oh-my-zsh
# XDG_CACHE_HOME=~/.cache

# --- Maintainers only: desktop release builds (set as GitHub Actions secrets, not locally) ---
# CSC_LINK=            # macOS signing certificate (base64 .p12)
# CSC_KEY_PASSWORD=    # its password
# WIN_CSC_LINK=        # Windows code-signing certificate
#
# Note: StackRadar sets STACKRADAR_RUN / STACKRADAR_GUARD / STACKRADAR_TARGET itself for the
# programs it starts; you never need to set those.
